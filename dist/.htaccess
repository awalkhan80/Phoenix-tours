# =======================================================================
# Phoenix Travel & Tours - Enterprise Apache Web Server Configuration
# Domain: https://desertsafaridxbpro.com
# Office: Office 701, XL Tower, Business Bay, Dubai, UAE
# WhatsApp: +971561505270
# =======================================================================

RewriteEngine On
RewriteBase /

# ----------------------------------------------------------------------
# 1. Custom 404 Error Handler & Recovery Page
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# 2. Canonical HTTPS & www removal
# ----------------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.desertsafaridxbpro\.com [NC]
RewriteRule ^(.*)$ https://desertsafaridxbpro.com/$1 [L,R=301]

# ----------------------------------------------------------------------
# 3. Permanent 301 Redirects for Legacy, Mistyped & Duplicate URLs
# ----------------------------------------------------------------------
# Desert Safari Redirects
Redirect 301 /safari /desert-safari-dubai.html
Redirect 301 /desert-safari /desert-safari-dubai.html
Redirect 301 /desert-safari/ /desert-safari-dubai.html
Redirect 301 /evening-desert-safari /desert-safari-dubai.html
Redirect 301 /morning-desert-safari /desert-safari-dubai.html
Redirect 301 /private-desert-safari /desert-safari-dubai.html
Redirect 301 /tours/desert-safari /desert-safari-dubai.html

# Quad Bike Redirects
Redirect 301 /quad /rides/quad-bike
Redirect 301 /quad/ /rides/quad-bike
Redirect 301 /quad-bike /rides/quad-bike
Redirect 301 /quad-bike/ /rides/quad-bike
Redirect 301 /quad-biking /rides/quad-bike
Redirect 301 /atv /rides/quad-bike
Redirect 301 /atv-rental /rides/quad-bike

# Dune Buggy Redirects
Redirect 301 /buggy /rides/buggy
Redirect 301 /buggy/ /rides/buggy
Redirect 301 /dune-buggy /rides/buggy
Redirect 301 /dune-buggy/ /rides/buggy
Redirect 301 /can-am /rides/buggy
Redirect 301 /canam /rides/buggy

# City Tour Redirects
Redirect 301 /city-tour /dubai-city-tour.html
Redirect 301 /city-tour/ /dubai-city-tour.html
Redirect 301 /dubai-city /dubai-city-tour.html
Redirect 301 /sightseeing /dubai-city-tour.html

# Abu Dhabi Redirects
Redirect 301 /abu-dhabi /abu-dhabi-city-tour.html
Redirect 301 /abu-dhabi/ /abu-dhabi-city-tour.html
Redirect 301 /abudhabi /abu-dhabi-city-tour.html
Redirect 301 /grand-mosque-tour /abu-dhabi-city-tour.html

# Skydive & Lake Ride Redirects
Redirect 301 /skydive /sky-dive-dubai.html
Redirect 301 /skydive-dubai /sky-dive-dubai.html
Redirect 301 /burj-lake /burj-khalifa-lake-ride.html
Redirect 301 /dubai-fountain /burj-khalifa-lake-ride.html

# Booking Redirect
Redirect 301 /booking /book
Redirect 301 /reserve /book

# ----------------------------------------------------------------------
# 4. Clean Routing & Semantic URLs
# ----------------------------------------------------------------------
RewriteRule ^rides/quad-bike/?$ quad-bike-dubai.html [L,QSA]
RewriteRule ^rides/buggy/?$ dune-buggy-dubai.html [L,QSA]
RewriteRule ^book/?$ book.html [L,QSA]
RewriteRule ^admin/?$ admin.html [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.xml [L]
RewriteRule ^robots\.txt$ robots.txt [L]

# ----------------------------------------------------------------------
# 5. Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# ----------------------------------------------------------------------
# 6. Performance & Asset Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
