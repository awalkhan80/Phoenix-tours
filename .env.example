# Phoenix Tours Environment Variables
PORT=3000
AUTH_SECRET=

# Email Notification System (SMTP)
# Configure your SMTP credentials below to send live emails via Brevo, SendGrid, Mailgun, Amazon SES, Gmail SMTP, Resend, etc.
# If left empty, email deliveries are recorded in server logs and admin notification history.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Phoenix Tours <bookings@phoenix-tours.ae>"
